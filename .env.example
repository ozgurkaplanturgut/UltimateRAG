# === App Settings ===
APP_NAME=sse-chatbot
APP_ENV=dev
LOG_LEVEL=INFO

# === OpenAI Settings ===
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# === Kafka Settings ===
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RAG_REQUEST_TOPIC=rag_requests
RAG_RESPONSE_TOPIC=rag_responses
RAG_WORKER_GROUP_ID=rag-worker
DISPATCHER_CONSUMER_GROUP=api-dispatcher

# === DLQ / Retry Settings ===
RAG_DLQ_TOPIC=rag_requests_dlq
MAX_RETRIES=5
RETRY_BASE_SECONDS=1.0
RETRY_MAX_SECONDS=30.0

# === Redis Settings ===
REDIS_URL=redis://redis:6379/0
IDEMPOTENCY_TTL_SECONDS=86400

# === MongoDB Settings ===
MONGO_DSN=mongodb://mongo:27017
MONGO_DB_NAME=sse_chatbot

# === Worker Settings ===
WORKER_MAX_CONCURRENCY=32

# === Qdrant Settings ===
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
QDRANT_COLLECTION=rag_hybrid
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# === RAG Knobs & Tuning ===
RAG_TOP_K=50
RAG_RERANK_TOP_K=10
RAG_RERANK_WINDOW_TOKENS=512
RAG_RERANK_STRIDE_TOKENS=128

RAG_CHUNK_TOKENS=500
RAG_OVERLAP_TOKENS=125
RAG_DOC_PROFILE_SAMPLE_CHARS=8000
RAG_PRF_LIMIT=3
RAG_PRF_SNIPPETS=3

RAG_REWRITE_USE_HISTORY=true
RAG_REWRITE_HISTORY_MAX_MESSAGES=5

# === Embedding & Encoder Models ===
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_CROSS_ENCODER_DEVICE=cuda
RAG_EMBED_BATCH=64
RAG_QDRANT_UPSERT_BATCH=128
RAG_SPARSE_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_SPARSE_MAX_TOKENS=1024

# === SSE API Timeouts (Seconds) ===
SSE_HEARTBEAT_S=15.0
SSE_MAX_IDLE_S=60.0
SSE_MAX_TOTAL_S=180.0

# === LLM Stream Timeouts (Seconds) ===
STREAM_FIRST_TOKEN_TIMEOUT=30.0
STREAM_IDLE_TIMEOUT=60.0
STREAM_HARD_TIMEOUT=120.0